#!/bin/sh
set -eu
# Load only Visual Status Checker's named profile. Do not write system configuration files.
profile="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)/visual-status-checker.apparmor"
if [ ! -x /sbin/apparmor_parser ]; then
  echo 'Visual Status Checker: AppArmor parser is unavailable; cannot load Chromium sandbox policy.' >&2
  exit 1
fi
/sbin/apparmor_parser --replace --skip-cache "$profile"
